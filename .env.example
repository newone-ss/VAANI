# ==============================================================================
# BiTe_me: Environment Configuration Template
# Copy this file to .env and adjust values for your environment.
# ==============================================================================

# Server Configuration
APP_ENV=development
HOST=0.0.0.0
PORT=8000
DEBUG=false

# Anti-Spoofing Inference Engine
# Options: "legacy" (vectorized filterbank/ONNX ensemble) or "huggingface" (Wav2Vec2-XLSR)
ANTI_SPOOF_BACKEND=legacy
ANTI_SPOOF_MODEL_NAME=Gustking/wav2vec2-large-xlsr-deepfake-audio-classification

# Out-of-Band n8n Orchestration Webhook
N8N_WEBHOOK_URL=http://localhost:5678/webhook/voice-threat
N8N_HMAC_SECRET=byte-me-security-enterprise-hmac-key-2026

# Speaker Biometric Non-Invertible Salt
SPEAKER_PROJECTION_SEED=429496729
